# Full Postgres connection string used by the app (postgres library)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Hostname of the Postgres server
PGHOST=host

# Postgres username
PGUSER=user

# Name of the database to connect to
PGDATABASE=dbname

# Postgres user's password
PGPASSWORD=password

# Same connection string, used by @vercel/postgres style config
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# Authentication secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-generated-secret-here

# Base URL used for auth callback routes
AUTH_URL=http://localhost:3000/api/auth